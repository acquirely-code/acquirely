# /lead-gen audit application ("Test form" button, components/audit-form). See docs/audit-form.md.

# ---- Storage ----
# Apps Script web app URL (ending /exec) for the Lead Gen Audit sheet. Keep it out of git: the repo is public.
# Blank: rows go to a local CSV, and the form answers "unavailable" on Vercel.
AUDIT_SHEET_WEBHOOK_URL=
# Default .data/audit-leads.csv
AUDIT_LOCAL_FILE=

# ---- Booking (qualified leads) ----
# Default https://booknow.acquirely.in/LGARC/#/LGARC
NEXT_PUBLIC_AUDIT_BOOKING_URL=

# ---- Tracking. Each one is skipped if blank. ----
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Meta Conversions API (server copies of the Pixel events, same event IDs).
# Events Manager > your Pixel > Settings > Conversions API > Generate access token.
META_CAPI_ACCESS_TOKEN=
# Optional: from Events Manager > Test events, to see server events there while testing. Remove after.
# If your host won't accept a blank value, enter "none".
META_CAPI_TEST_EVENT_CODE=
# Default v23.0
META_GRAPH_API_VERSION=
